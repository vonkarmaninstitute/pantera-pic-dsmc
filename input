!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!                 Input file for PANTERA                                !!!!
!!!!                                                                       !!!!
!!!! The program reads is line by line, and when it finds a known line, it !!!!
!!!! reads and saves the value in the next one.                            !!!!
!!!! All other lines are ignored (you can comment etc).                    !!!!
!!!! You can put trailing comments on lines, starting with "!" symbol:     !!!!
!!!! the program will remove them before checking the content of a line.   !!!!
!!!!                                                                       !!!!
!!!! All units are SI [m, kg, s, ...]                                      !!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

! ========= Computational domain and grid ===========

Dimensions:
   2 
Axisymmetric:
    .TRUE.
Domain_limits:
  -0.00001 10.0001e-3    0.0  5.0001e-3      -3.14  3.14
Number_of_cells:
    1    1    1 
Domain_periodicity:
    .FALSE.   .FALSE.   .TRUE.
Domain_specular:
    .FALSE.    .FALSE.    .TRUE.    .FALSE.
Domain_diffuse:
    .FALSE.    .FALSE.    .FALSE.    .FALSE.

Mesh_file_SU2:
    'mesh_feb_20.su2'

Boundary_temperature:
    300.0

Bool_dump_moments:
    .FALSE.
Bool_dump_fluxes:
    .FALSE.

All_output_path:
 './dumps/'


! ========= Numerical parameters =============================

Fnum:  ! Ratio of real-to-simulated particles
    2e7 
Timestep:
    2.50e-10
Number_of_timesteps:
    100000
Stats_every:
    1
RNG_seed:
    1
Dump_part_every:
    1000000
Dump_grid_start:
    10000
Dump_grid_avgevery:
    500 
Dump_grid_numavgs:
    20

Dump_bound_start:
   1000000
Perform_checks:
    .TRUE.
! ========= Species and mixtures ==============================

Species_file:
    Si_N2.species
Def_mixture:
    Evapo N2 0.5 Si 0.5
Def_mixture: 
    Silicon Si 1.0
Def_mixture: 
    Nitrogen N2 1.0
!Def_mixture: 
!    Magnesium Mg 1.0
! ========= Collisions ========================================

Collision_type: ! [MCC / DSMC / NONE]
  MCC

!MCC_background_dens:
!  1.0e20

MCC_background_mixture:
   Nitrogen 

Remove_particles_in_mixture: 
   Nitrogen

MCC_background_file: 
  'dsmc_flowfield_90000.vtk'

!DSMC_collisions_mixture:
!   Evapo

VSS_parameters_binary_file: 
   Si_N2.vssbin
!VSS_parameters_file: 
!     test.vss


Thermal_bath_bool:
    .FALSE.
Thermal_bath_Ttr:
    20000.0


! ========= Reactions ==============================
!Reactions_file:
Wall_reactions_file: 
    Silicon_condensation     
! ========= Initial particle seed ===================

Initial_particles_bool:
    .FALSE.
Initial_particles_dens:
    1.e6
Initial_particles_vel:
    0.  0.  0.
Initial_particles_Ttra:
    300.0 300.0 300.0
Initial_particles_Trot:
    0.
Initial_particles_Tvib:
    0. 
Initial_particles_mixture:
    Nitrogen
Initial_particles_mixture:
    Silicon   

! ========== Particle Injection ==================
!   |Name| |Mix| |Dens|  |Vel -> x,y,z| |Temp -> x,y,z| |Vaporization Coefficient|

!Boundary_emit: 
!    inlet  Nitrogen  6.3e19 21520.0 0.0 0.0 200.0 200.0 200.0 1.0  
!Boundary_emit: 
!    outlet Nitrogen  6.3e19 21520.0 0.0 0.0 200.0 200.0 200.0 1.0  
!Boundary_emit: 
!    top    Nitrogen  6.3e19 21520.0 0.0 0.0 200.0 200.0 200.0 1.0   
!Boundary_emit: 
!    bottom Nitrogen  6.3e19 21520.0 0.0 0.0 200.0 200.0 200.0 1.0   

!   |Name|     |Class| |Temp|
Boundary_condition:
    sphere      diffuse 3896.3
Boundary_emit:
    sphere Silicon 1.59e23 0.0 0.0 0.0 3896.3 3896.3 3896.3 0.5  
Boundary_condition: 
    sphere react  

     
! ========= MPI parallelization =====================
! == Style for MPI domain partition can be:
! ==
! == 0: longitudinal strips (along x)
! == 1: blocks (equally sized)
!
! For "blocks" style, provide "Domain_partition_num_blocks", giving
! the number of blocks along x and y.
! We expect the number of processes to be N_BLOCKS_X*N_BLOCKS_Y

Partition_num_blocks:
    3  3

Partition_style: 
    stripsy

Load_balance:
    .FALSE.


